// Configuration for production/debug mode
const DEBUG = false;

/**
 * Safe logging utility - logs only in debug mode
 */
function debugLog(message) {
    if (DEBUG) {
        console.log(message);
    }
}

document.addEventListener('DOMContentLoaded', () => {
    debugLog("%c[Alembeela Foundation] Advanced platform script fully initialized. Úmbo Cha Babembe & Community Hub active.", "color: #eab308; font-weight: bold; background: #03140c; padding: 4px;");
    
    // Initialize components
    initSmoothScrolling();
    
    // Set default language to English
    setLanguage('en');
});

/**
 * 1. Real-Time Episode Search / Filter Engine
 * Filters the video grid dynamically based on user typing.
 */
function filterEpisodes() {
    // Safely get the search input
    const searchInput = document.getElementById('episodeSearch');
    if (!searchInput) {
        console.warn("[Search Error] Element with id 'episodeSearch' not found.");
        return;
    }
    
    const input = searchInput.value.toLowerCase();
    const cards = document.querySelectorAll('.episode-card');
    
    if (cards.length === 0) {
        console.warn("[Search Warning] No episode cards found with class 'episode-card'.");
        return;
    }

    cards.forEach(card => {
        const title = card.getAttribute('data-title');
        
        // Safely handle missing data-title attribute
        if (!title) {
            console.warn("[Search Warning] Episode card missing 'data-title' attribute.");
            return;
        }
        
        if (title.toLowerCase().includes(input)) {
            card.style.display = 'flex';
        } else {
            card.style.display = 'none';
        }
    });
    
    debugLog(`[Search Log] Filtering episode library with keyword: "${input}"`);
}

